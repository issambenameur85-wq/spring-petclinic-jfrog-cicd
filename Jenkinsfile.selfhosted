pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Compile') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'jfrog-selfhosted-credentials',
                        usernameVariable: 'ARTIFACTORY_USERNAME',
                        passwordVariable: 'ARTIFACTORY_PASSWORD'
                    ),
                    string(
                        credentialsId: 'jfrog-selfhosted-url',
                        variable: 'ARTIFACTORY_URL'
                    )
                ]) {
                    sh './mvnw -s .mvn/jfrog-selfhosted-settings.xml compile'
                }
            }
        }

        stage('Test') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'jfrog-selfhosted-credentials',
                        usernameVariable: 'ARTIFACTORY_USERNAME',
                        passwordVariable: 'ARTIFACTORY_PASSWORD'
                    ),
                    string(
                        credentialsId: 'jfrog-selfhosted-url',
                        variable: 'ARTIFACTORY_URL'
                    )
                ]) {
                    sh './mvnw -s .mvn/jfrog-selfhosted-settings.xml test'
                }
            }
        }

        stage('Package') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'jfrog-selfhosted-credentials',
                        usernameVariable: 'ARTIFACTORY_USERNAME',
                        passwordVariable: 'ARTIFACTORY_PASSWORD'
                    ),
                    string(
                        credentialsId: 'jfrog-selfhosted-url',
                        variable: 'ARTIFACTORY_URL'
                    )
                ]) {
                    sh './mvnw -s .mvn/jfrog-selfhosted-settings.xml package -DskipTests'
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t spring-petclinic:selfhosted .'
            }
        }

       stage('Docker Push') {
           steps {
               withCredentials([
                   usernamePassword(
                       credentialsId: 'jfrog-selfhosted-credentials',
                       usernameVariable: 'ARTIFACTORY_USERNAME',
                       passwordVariable: 'ARTIFACTORY_PASSWORD'
                   ),
                   string(
                       credentialsId: 'jfrog-selfhosted-docker-registry',
                       variable: 'DOCKER_REGISTRY'
                   )
               ]) {
                   sh '''
                       echo "$ARTIFACTORY_PASSWORD" | docker login "$DOCKER_REGISTRY" \
                           -u "$ARTIFACTORY_USERNAME" \
                           --password-stdin

                       docker tag spring-petclinic:selfhosted \
                           "$DOCKER_REGISTRY/docker-local/spring-petclinic:selfhosted"

                       docker push \
                           "$DOCKER_REGISTRY/docker-local/spring-petclinic:selfhosted"
                   '''
               }
           }
       }
    }
}
