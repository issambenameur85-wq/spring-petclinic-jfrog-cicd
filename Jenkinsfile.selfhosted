pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Compile') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'jfrog-selfhosted-credentials',
                        usernameVariable: 'ARTIFACTORY_USERNAME',
                        passwordVariable: 'ARTIFACTORY_PASSWORD'
                    ),
                    string(
                        credentialsId: 'jfrog-selfhosted-url',
                        variable: 'ARTIFACTORY_URL'
                    )
                ]) {
                    sh './mvnw -s .mvn/jfrog-selfhosted-settings.xml compile'
                }
            }
        }

        stage('Test') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'jfrog-selfhosted-credentials',
                        usernameVariable: 'ARTIFACTORY_USERNAME',
                        passwordVariable: 'ARTIFACTORY_PASSWORD'
                    ),
                    string(
                        credentialsId: 'jfrog-selfhosted-url',
                        variable: 'ARTIFACTORY_URL'
                    )
                ]) {
                    sh './mvnw -s .mvn/jfrog-selfhosted-settings.xml test'
                }
            }
        }

        stage('Package') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'jfrog-selfhosted-credentials',
                        usernameVariable: 'ARTIFACTORY_USERNAME',
                        passwordVariable: 'ARTIFACTORY_PASSWORD'
                    ),
                    string(
                        credentialsId: 'jfrog-selfhosted-url',
                        variable: 'ARTIFACTORY_URL'
                    )
                ]) {
                    sh './mvnw -s .mvn/jfrog-selfhosted-settings.xml package -DskipTests'
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t spring-petclinic:selfhosted .'
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'jfrog-selfhosted-credentials',
                        usernameVariable: 'ARTIFACTORY_USERNAME',
                        passwordVariable: 'ARTIFACTORY_PASSWORD'
                    ),
                    string(
                        credentialsId: 'jfrog-selfhosted-url',
                        variable: 'ARTIFACTORY_URL'
                    )
                ]) {
                    sh '''
                        docker login -u $ARTIFACTORY_USERNAME -p $ARTIFACTORY_PASSWORD $ARTIFACTORY_URL
                        docker tag spring-petclinic:selfhosted $ARTIFACTORY_URL/spring-petclinic:selfhosted
                        docker push $ARTIFACTORY_URL/spring-petclinic:selfhosted
                    '''
                }
            }
        }
    }
}
